{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".github/**",
      "node_modules/**",
      ".wrangler/**",
      "docs/**",
      "scripts/**",
      "tools/**",
      "dist/**",
      "thumb_*.jpg"
    ],
    "not_found_handling": "single-page-application"
  }
}
