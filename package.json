{
  "name": "geoatlas-interactive",
  "version": "2026.4.0",
  "private": true,
  "description": "GeoAtlas Interactive 2026 - Bản đồ số Atlat & Luyện thi Địa lí THPT (GDPT 2018)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind-input.css -o css/tailwind.css --minify",
    "build:data": "python scripts/rebuild_all.py",
    "check:data": "python scripts/rebuild_all.py --check",
    "test:legacy": "node scripts/run_legacy_tests.js",
    "test:smoke": "node scripts/smoke.mjs",
    "test": "npm run test:legacy && npm run check:data && npm run test:smoke"
  },
  "devDependencies": {
    "puppeteer-core": "^23.0.0",
    "tailwindcss": "^3.4.17"
  }
}
