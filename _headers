# ==============================================================================
# Cloudflare Pages & Netlify - Production HTTP Headers Configuration
# Optimized for High Traffic (10,000+ Concurrent Users) & Zero-Cost Serverless
# ==============================================================================

# 1. Dữ liệu bản đồ GeoJSON & JSON: Lưu cache trình duyệt 1 năm (31,536,000s)
# Cloudflare Edge CDN tự động nén Brotli / Gzip giảm 85% dung lượng truyền tải
/public/data/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  X-Content-Type-Options: nosniff

# 2. Mã nguồn JS và CSS: Lưu cache 30 ngày kèm cơ chế stale-while-revalidate
/js/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/css/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# 3. HTML chính (Single-Page Application): Luôn revalidate để học sinh nhận cập nhật mới nhất
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# 4. Fallback mặc định cho toàn bộ trang
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

